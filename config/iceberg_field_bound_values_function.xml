        <stderr_reaction>log</stderr_reaction>
        <command>ch-iceberg function iceberg-field-bound-values</command>
        <command_read_timeout>600000</command_read_timeout>
        <command_write_timeout>600000</command_write_timeout>

        <argument>
            <name>catalog</name>
            <type>String</type>
        </argument>
        <argument>
            <name>table</name>
            <type>String</type>
        </argument>
        <argument>
            <name>field_name</name>
            <type>String</type>
        </argument>

        <return_type>JSON</return_type>
    </function>
</functions>